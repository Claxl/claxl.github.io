@inproceedings{disalvo2026starbench,
  abbr         = {SIGMETRICS},
  title        = {Are We Ready to Enable Satellite Autonomy Through On-Board Image Registration?},
  author       = {Di Salvo, Claudio and Conficconi, Davide},
  booktitle    = sigmetrics,
  year         = {2026},
  selected     = {true},
  bibtex_show  = {true},
  abstract     = {Satellite autonomy requires on-board image registration that is both
                  accurate and efficient under strict power and thermal constraints. We
                  introduce STAR-Bench, a benchmark of roughly 24k registration tasks
                  spanning terrain types and difficulty levels, and characterize the
                  design space of on-board registration pipelines. We quantify the
                  accuracy/energy trade-offs of feature- and intensity-based approaches
                  and derive guidelines for bringing registration on board.},
  pdf          = {paper-sigmetrics26.pdf},
  code         = {https://github.com/claudiodisalvo/star-bench},
  note         = {First-author paper.}
}

@inproceedings{disalvo2026uchiha,
  abbr         = {FCCM},
  title        = {{UCHIHA}: A Domain-Specific {CGRA} Overlay with {QAC}-Driven Spatial
                  Reconfiguration for Satellite Vision},
  author       = {Di Salvo, Claudio and Conficconi, Davide},
  booktitle    = {IEEE International Symposium on Field-Programmable Custom Computing Machines (FCCM), PhD Forum},
  year         = {2026},
  selected     = {true},
  bibtex_show  = {true},
  abstract     = {We present UCHIHA, a domain-specific CGRA overlay with QAC-driven
                  spatial reconfiguration for on-board satellite vision. PEs hold
                  per-cell configuration registers and are orchestrated by an ARM
                  hard-core over AXI. A planned ASIC tape-out through open shuttle
                  programs targets radiation- and power-constrained deployment.}
}

